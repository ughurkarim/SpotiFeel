FLASK_SECRET=replace-with-a-long-random-string
FLASK_DEBUG=true
# Set in deployed environments. Vercel sets VERCEL_ENV automatically.
SPOTIFEEL_ENV=development
# Required in production for durable server-side sessions.
REDIS_URL=

SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5001/callback

# Optional integrations used by existing SpotiFeel features.
LASTFM_API_KEY=
YOUTUBE_API_KEY=
